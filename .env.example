# FastAPI
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://homeclinic:homeclinic_pw@db:5432/homeclinic
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://redis:6379

# WhatsApp
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=<your-phone-number-id>
WHATSAPP_BUSINESS_ACCOUNT_ID=<your-biz-account-id>
WHATSAPP_API_TOKEN=<your-graph-api-token>
WHATSAPP_VERIFY_TOKEN=<your-verify-token>
WHATSAPP_APP_SECRET=<your-app-secret>

# Gemini API
GOOGLE_GENERATIVEAI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.0-flash

# Encryption
FERNET_KEY=<auto-generated-base64-key>

# Admin
ADMIN_JWT_SECRET=<your-jwt-secret>
ADMIN_JWT_ALGORITHM=HS256

# Geocoding (optional, for location-based provider search)
GOOGLE_MAPS_API_KEY=<optional>

# Alerts
EMERGENCY_ESCALATION_EMAIL=admin@homeclinic.local
